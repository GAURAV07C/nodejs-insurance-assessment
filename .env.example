PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/insurance_assessment
# For MongoDB Atlas, replace the line above with your connection string, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/insurance_assessment

NODE_ENV=development

LOG_LEVEL=info
CPU_THRESHOLD=70
CPU_MONITOR_INTERVAL=5000
